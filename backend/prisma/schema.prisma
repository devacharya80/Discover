// Discover database schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  password String?
  role UserRole @default(USER)
  location UserLocation?
  companyMembers CompanyMember[]
  applications Application[]
  savedJobs SavedJob[]
  companyClaimRequests CompanyClaimRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum UserRole {
  USER
  ADMIN
}

model UserLocation {
  id String @id @default(uuid())
  address String
  city String
  state String
  country String @default("INDIA")
  latitude Float?
  longitude Float?
  pincode String
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(uuid())
  name String
  slug String @unique
  industry String
  description String
  website String?
  logoUrl String?
  foundedYear Int?
  companySize CompanySize @default(SEED_1_10)
  status CompanyStatus @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  createdSource CreatedSource
  companyMembers CompanyMember[]
  companyLocations CompanyLocation[]
  jobs Job[]
  companyClaimRequests CompanyClaimRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([industry])
  @@index([status])
  @@index([name])
}
enum CompanySize {
  SEED_1_10
  SMALL_11_50
  MEDIUM_51_200
  MIDMARKET_201_500
  LARGE_501_1000
  ENTERPRISE_1000_PLUS
}
enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}
enum VerificationStatus {
  VERIFIED
  PENDING
  REJECTED
}
enum CreatedSource {
  DISCOVERED
  COMPANY_CREATED
  ADMIN_CREATED
}

model CompanyMember {
  id String @id @default(uuid())
  userId String
  companyId String
  role CompanyRole
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, companyId])
  @@index([companyId, role])
}
enum CompanyRole {
  ADMIN
  OWNER
  RECRUITER
}

model CompanyLocation {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name String
  address String
  city String
  state String
  country String @default("INDIA")
  latitude Float?
  longitude Float?
  pincode String
  isPrimary Boolean
  jobs Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([city])
  @@index([state])
  @@index([companyId, isPrimary])
}

model Job {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId String?
  location CompanyLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  title String
  description String @db.Text
  type WorkType @default(FULL_TIME)
  mode WorkMode @default(REMOTE)
  experienceLevel ExperienceLevel @default(ENTRYLEVEL)
  skills String[]
  salaryMin Int?
  salaryMax Int?
  externalLink String?
  source JobSource
  status JobStatus @default(ACTIVE)
  expiresAt DateTime?
  applications Application[]
  savedBy SavedJob[]
  externalJob ExternalJob?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([locationId])
  @@index([type])
  @@index([mode])
  @@index([experienceLevel])
  @@index([status, createdAt])
  @@index([expiresAt])
}
enum WorkType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}
enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}
enum ExperienceLevel {
  ENTRYLEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
}
enum JobSource {
  PLATFORM
  EXTERNAL
}
enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

model ExternalJob {
  id String @id @default(uuid())
  provider String
  externalId String
  fingerprint String?
  externalLocationName String?
  externalCity String?
  externalState String?
  externalCountry String?
  externalLatitude Float?
  externalLongitude Float?
  jobId String @unique
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@unique([provider, externalId])
  @@index([fingerprint])
  @@index([provider])
}

model Application {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status ApplicationStatus @default(APPLIED)
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, jobId])
  @@index([userId, appliedAt])
  @@index([jobId, status])
}
enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

model SavedJob {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model CompanyClaimRequest {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status ClaimStatus @default(PENDING)
  requestedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, status])
  @@index([userId, status])
}
enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}
